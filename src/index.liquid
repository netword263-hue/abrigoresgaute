---
layout: layout.liquid
title: Abrigo Resgaute
---
<section class="topo">
  <img src="/img/banner-topo.webp" alt="Da inocência de uma criança nasceu o Abrigo Resgaute">
</section>

<section class="video">
  <div class="wrap center">
    <div class="video-card">
      <div class="vimeo-container">
        <iframe
          src="https://player.vimeo.com/video/1248769234?title=0&byline=0&portrait=0&autopause=0&player_id=0&app_id=58479"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
          title="História do Abrigo Resgaute">
        </iframe>
      </div>
    </div>
    <p><a class="btn" href="#doar">Quero ajudar</a></p>
  </div>
</section>

<section class="proposito">
  <div class="wrap">
    <h2 class="titulo">Entenda Nosso Propósito</h2>
    <div class="cartao-img"><img src="/img/bannerresgaute.webp" alt="Aqui na Resgaute cada vida importa e cada gesto salva"></div>

    <div class="cartao-grad">
      <span class="tag">Da inocência ao resgate</span>
      <p>Me chamo Luana e desde criança tenho uma grande paixão pelos animais. Há quatro anos, dei vida ao Projeto Resgaute, uma missão de amor e esperança. Com fé em Deus e com o apoio de pessoas incríveis como você, já salvamos mais de 4.500 vidas. 🐾</p>
    </div>

    <div class="stats">
      <div class="stat"><span>🐶 +4.500</span><b>VIDAS</b></div>
      <div class="stat"><span>❤️ 500</span><b>ANIMAIS</b></div>
    </div>

    <div class="cartao-grad centro">
      <p>Hoje, mais de 500 animais resgatados dependem do nosso abrigo para não passar fome, receber cuidados e ter uma nova chance de ser feliz.</p>
    </div>
    <p class="center"><a class="btn" href="#doar">Quero ajudar</a></p>
  </div>
</section>

<section class="ajude">
  <div class="wrap">
    <h2 class="titulo">Ajude o Abrigo</h2>
    <div class="carousel" data-carousel>
      <div class="track">
        {% for s in site.ajude %}
        <article class="slide cartao-slide">
          <img src="{{ s.imagem }}" alt="{{ s.titulo }}">
          <div class="corpo">
            <h3>{{ s.titulo }}</h3>
            <p>{{ s.texto }}</p>
          </div>
        </article>
        {% endfor %}
      </div>
      <div class="nav">
        <button class="seta prev" type="button" aria-label="Anterior">‹</button>
        <div class="dots"></div>
        <button class="seta next" type="button" aria-label="Próximo">›</button>
      </div>
    </div>
  </div>
</section>

<section class="impacto-sec">
  <div class="wrap">
    <h2 class="titulo">O impacto da sua ajuda</h2>
    <div class="impacto">
      {% for item in site.impacto %}
      <button type="button" data-valor="{{ item.valor }}">
        <span class="valor">🩵 {{ item.rotulo }}</span>
        <span>{{ item.texto }}</span>
      </button>
      {% endfor %}
    </div>
    <p class="amor">Toda doação é um ato de amor. 🐾</p>
  </div>
</section>

<section class="pix" id="doar">
  <div class="wrap-pix">
    <h2 class="titulo">Ajudar via PIX</h2>
    <img class="pix-marca" src="/img/pixsemfundo.png" alt="Pix">
    <div class="pix-card">
      <div class="valores">
        <button type="button" data-valor="25">R$ 25</button>
        <button type="button" data-valor="50">R$ 50</button>
        <button type="button" data-valor="100">R$ 100</button>
        <button type="button" data-valor="200">R$ 200</button>
      </div>
      <input id="valor" class="outro" type="number" inputmode="decimal" min="11" step="0.01" placeholder="Outro valor (mínimo R$ 11)">
      <button id="btn-pix" class="btn btn-pequeno" type="button">Gerar PIX</button>
      <div id="resultado" aria-live="polite"></div>
    </div>
  </div>
</section>

<section class="historias">
  <div class="wrap">
    <h2 class="titulo">Histórias de Transformação</h2>
    <p class="sub">Estas são algumas das centenas de animais que conseguimos resgatar e reabilitar graças ao seu apoio.</p>
    <div class="carousel azul" data-carousel>
      <div class="track">
        {% for h in site.historias %}
        <div class="slide img-slide"><img src="{{ h.imagem }}" alt="{{ h.alt }}" loading="lazy"></div>
        {% endfor %}
      </div>
      <div class="nav">
        <button class="seta prev" type="button" aria-label="Anterior">‹</button>
        <div class="dots"></div>
        <button class="seta next" type="button" aria-label="Próximo">›</button>
      </div>
    </div>
  </div>
</section>

<section class="adocao">
  <div class="wrap">
    <h2 class="titulo">Adoção que transforma vidas</h2>
    <div class="carousel" data-carousel>
      <div class="track">
        {% for a in site.adocoes %}
        <div class="slide img-slide"><img src="{{ a.imagem }}" alt="{{ a.alt }}" loading="lazy"></div>
        {% endfor %}
      </div>
      <div class="nav">
        <button class="seta prev" type="button" aria-label="Anterior">‹</button>
        <div class="dots"></div>
        <button class="seta next" type="button" aria-label="Próximo">›</button>
      </div>
    </div>
  </div>
</section>

<section class="local">
  <div class="wrap">
    <h2 class="titulo">Nossa Localização</h2>
    <div class="mapa">
      <iframe src="https://www.google.com/maps?q=Vargem+Grande+Paulista+SP&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mapa da localização"></iframe>
    </div>
    <div class="info-card">
      <div class="info-topo"><img src="/img/logo.png" alt=""><strong>{{ site.nome }}</strong></div>
      <ul>
        <li><span class="ic">📍</span><div><b>Localização</b><br>{{ site.cidade }}</div></li>
        <li><span class="ic">🪪</span><div><b>CNPJ</b><br><span class="cnpj">{{ site.cnpj }}</span></div></li>
      </ul>
    </div>
  </div>
</section>

<section class="faca-parte">
  <div class="wrap center">
    <h2 class="titulo sem-linha">Faça Parte Desta História</h2>
    <p>Cada doação, cada compartilhamento, cada gesto de amor faz a diferença na vida de centenas de animais que dependem da nossa ajuda.</p>
    <p><a class="btn" href="#doar">Quero ajudar</a></p>
  </div>
</section>

<footer class="rodape">
  <div class="wrap">
    <div class="rodape-logo"><img src="/img/logo.png" alt="Resgaute"><h3>{{ site.nome }}</h3></div>

    <h4>Contato</h4>
    <p>WhatsApp:<br><a href="{{ site.whatsappLink }}">{{ site.whatsapp }}</a></p>
    <p>Email:<br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>

    <h4>Redes Sociais</h4>
    <a class="rede" href="{{ site.redes.facebook }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/></svg>
      Facebook
    </a>
    <a class="rede" href="{{ site.redes.instagram }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="28" height="28"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
      Instagram
    </a>
    <a class="rede" href="{{ site.redes.tiktok }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.6 2.6 0 0 1 0-5.2c.27 0 .53.04.77.12V9.66a5.7 5.7 0 0 0-.77-.05 5.69 5.69 0 1 0 5.69 5.69V8.98a7.35 7.35 0 0 0 4.29 1.37V7.3a4.3 4.3 0 0 1-3.28-1.48z"/></svg>
      TikTok
    </a>

    <h4>Como Ajudar</h4>
    <ul class="links">
      <li><a href="#doar">Doações PIX</a></li>
      <li><a href="{{ site.whatsappLink }}">Adoção Responsável</a></li>
      <li><a href="{{ site.whatsappLink }}">Voluntariado</a></li>
      <li><a href="{{ site.whatsappLink }}">Apadrinhamento</a></li>
    </ul>

    <div class="copy">
      <p>© 2026 {{ site.recebedor }}. Todos os direitos reservados.</p>
      <p>Desenvolvido com 💗 para salvar vidas</p>
      <p>{{ site.cnpj }}</p>
    </div>
  </div>
</footer>